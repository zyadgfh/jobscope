# JobScope environment matrix — server-side only; never ship these to browser code.
# Full guide: docs/DEPLOYMENT.md

# ---------------------------------------------------------------------------
# Control plane used by the Vercel/Node API layer.
#   - "local" (or unset with `npm start`): in-process control plane, no cloud needed.
#   - Unset outside `npm start`: the built-in project default below is used.
#   - Production: set the deployed Edge Function URL explicitly.
# ---------------------------------------------------------------------------
RESEARCH_CONTROL_URL=local
# RESEARCH_CONTROL_URL=https://YOUR_PROJECT.supabase.co/functions/v1/research-control

# ---------------------------------------------------------------------------
# Local development only — where the in-process control plane keeps its JSON store.
# Not for Vercel: its filesystem is read-only/ephemeral.
# ---------------------------------------------------------------------------
# JOBSCOPE_LOCAL_STORE=/tmp/jobscope-local-control.json

# ---------------------------------------------------------------------------
# Supabase Edge Function runtime (`research-control`). These live inside the
# function on Supabase — do NOT add them to Vercel or to any browser asset.
# Supabase injects them automatically for functions in the project; listed here
# so the required names are documented.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# GitHub Actions deployment (repository secrets, not environment variables):
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID  -> .github/workflows/deploy-vercel.yml
#   RESEARCH_CONTROL_URL                            -> runs `npm run deploy:check` after deploy
# ---------------------------------------------------------------------------
