# Server-side only; never put these values in browser code.

# Control plane used by the Vercel/Node API layer.
#   - Leave empty / use "local" to run the in-process control plane (local development).
#   - Set the deployed Edge Function URL in production.
RESEARCH_CONTROL_URL=local

# Optional: where the local control plane keeps its JSON store (defaults to the OS temp dir).
# JOBSCOPE_LOCAL_STORE=/tmp/jobscope-local-control.json

# Supabase Edge Function runtime (research-control) reads these inside the function,
# never in the browser bundle:
#   SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
