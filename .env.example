# Server-side only; never put these values in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SERVER_SIDE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
OWNER_EMAIL=zyadgamal796@gmail.com
# Optional server-side search providers. Add before Production.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Do not put provider secrets in browser assets.
# Store production provider secrets in Supabase Vault/Secret Store and expose only server-side.
# Firebase is optional for notifications/analytics and is not used for report storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
