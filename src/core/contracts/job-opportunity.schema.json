{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobscope://schemas/job-opportunity",
  "title": "JobOpportunity",
  "description": "Canonical job entity for a run. A Job Posting is one source's view of it.",
  "type": "object",
  "required": ["id", "canonical_key"],
  "properties": {
    "id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "canonical_key": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "company": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "salary": {"type": ["object", "null"]},
    "requirements": {"type": "array"},
    "benefits": {"type": "array"},
    "employment": {"type": "object"},
    "fit": {"type": ["object", "null"]},
    "risk": {"type": ["object", "null"]},
    "decision_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "objective_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "data_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "opportunity_cost": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "risk_flags": {"type": "array"},
    "financial": {"type": "object"},
    "career": {"type": "object"},
    "decision_components": {"type": "object"}
  }
}
