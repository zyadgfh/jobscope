{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobscope://schemas/job-opportunity",
  "type": "object",
  "required": ["id","title","company","postings"],
  "properties": {
    "id":{"type":"string"},
    "title":{"type":"string"},
    "company":{"type":"object","required":["name"],"properties":{"name":{"type":"string"},"canonicalId":{"type":["string","null"]}}},
    "location":{"type":["object","null"]},
    "postings":{"type":"array","items":{"type":"object","required":["sourceId"],"properties":{"sourceId":{"type":"string"},"url":{"type":["string","null"],"format":"uri"},"firstSeenAt":{"type":["string","null"],"format":"date-time"},"lastSeenAt":{"type":["string","null"],"format":"date-time"}}}},
    "salary":{"type":["object","null"]},
    "confidence":{"type":"number","minimum":0,"maximum":1}
  }
}