{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobscope://schemas/evidence",
  "title": "Evidence",
  "description": "A stored evidence row. Absence of evidence is never a positive claim.",
  "type": "object",
  "required": ["claim", "status", "confidence"],
  "properties": {
    "id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "sourceId": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "claim": {"type": "string", "minLength": 1},
    "status": {"enum": ["verified_fact", "reported", "estimated", "inferred", "unknown", "conflicting"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "object"},
    "retrievedAt": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
