{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobscope://schemas/evidence",
  "type": "object",
  "required": ["id","claimId","sourceId","retrievedAt","status","confidence"],
  "properties": {
    "id":{"type":"string"},
    "claimId":{"type":"string"},
    "sourceId":{"type":"string"},
    "retrievedAt":{"type":"string","format":"date-time"},
    "status":{"enum":["verified_fact","reported","estimated","inferred","unknown","conflicting"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "sourceSpan":{"type":"object","properties":{"locator":{"type":"string"},"text":{"type":"string"}}}
  }
}